# Copy this file to .env and fill in the values you have.
# .env is gitignored. Do not put real keys in .env.example.

# DuckDB file for local research data. The data/ directory is gitignored.
DRIFTWOOD_DB=data/driftwood.duckdb

# Alpaca paper trading only. The client refuses any host other than the paper API.
# Used from the paper-trading milestone onward.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# xAI key for the research agent (langchain-xai ChatXAI). The model name is configurable.
# Used from the research-agent milestone onward.
XAI_API_KEY=
XAI_MODEL=grok-4
